# SPDX-License-Identifier: Apache-2.0
# Zero Zero Computer - Aruba Linux Hosting .htaccess

RewriteEngine On

# Forza HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Reindirizza link relativi erroneamente richiesti sotto /ai/ verso la radice
RewriteRule ^ai/(token(\.html)?|join(\.html)?|chat(\.html)?|privacy(\.html)?|privacy-policy(\.html)?|deletion(\.html)?|data-deletion(\.html)?|progetto(\.html)?|docs/(.*)|src/(.*)|assets/(.*))$ /$1 [R=301,L]

# URL puliti: la build copia ogni pagina in una cartella (join.html -> join/index.html),
# e /join diventa /join/. Da lì i percorsi relativi della pagina (./src/index.js,
# ./join-config.js, ./guide.html, il Web Worker ./src/worker.js) si risolvono dentro
# la cartella e davano 404. Se il file chiesto non esiste nella cartella, si serve
# quello della radice: le pagine con un redirect (l'indirizzo giusto resta visibile),
# script, stili e immagini direttamente.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^[a-z0-9-]+/([a-z0-9-]+\.html)$ /$1 [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^[a-z0-9-]+/(.+)$ /$1 [L]

# Supporto manifesto AI Agent in /.well-known/ai-agent.json
RewriteRule ^\.well-known/ai-agent\.json$ /ai-agent.json [L]

# Supporto URL senza estensione .html (es. /privacy, /privacy-policy, /deletion, /join, /ai)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]

DirectoryIndex index.html

# Gestione MIME per moduli ES Javascript, manifesti AI e documenti
AddType application/javascript .js .mjs
AddType application/json .json
AddType text/plain .txt
AddType text/html .html
AddType application/pdf .pdf

# Bypassa la HiSpeed Cache di Aruba e previene cache stale su browser e CDN
<IfModule mod_headers.c>
  Header always set Cache-Control "no-cache, no-store, must-revalidate, private"
  Header always set Pragma "no-cache"
  Header always set Expires "0"
</IfModule>
