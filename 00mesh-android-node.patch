 NODE_CAPABILITIES.append("v1-chat-completions")
 
+# ── NODO MOBILE (telefono Android in Termux) ─────────────────────────────
+# NODE_TIER=mobile accende il gate di shared/mobile_gate.py: il nodo accetta
