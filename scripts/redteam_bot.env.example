# Red-team harness — modello di configurazione.
# Copia in scripts/redteam_bot.env e riempi SOLO il file copiato (mai questo).
# Nessun valore reale qui. scripts/redteam_bot.env NON va committato.

# ── Opzione A: user-bot Telegram (telethon/pyrogram), la TUA sessione ─────
# Credenziali da https://my.telegram.org → API development tools.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=data/redteam_bot
# Username del bot da collaudare (con la @).
BOT_USERNAME=@tuo_bot

# ── Opzione B: endpoint HyperSpace del canale del bot ────────────────────
HYP_CP_URL=http://127.0.0.1:8085
HYP_CHANNEL_TOKEN=
