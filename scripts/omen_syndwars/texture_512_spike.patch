 /******************************************************************************/
+
+
+/******************************************************************************/
+/* Rasterizzatore texturizzato per pagine a risoluzione piu' alta (pitch_sh bit, UV scalate di `scale`).
+ * Sostituisce draw_gpoly() nei modi 5 (sfumato) e 27 (colore del texel): X e Y dei vertici sono interi,
+ * U, V e S sono in 16.16 con il valore utile nella parte intera, come in gpoly_init_state().
+ * Copertura sui punti a coordinate intere, regola top-left; attributi interpolati in modo affine. */
+static inline long long hires_edge(long px, long py, long qx, long qy, long x, long y)
+{
+    return (long long)(qx - px) * (y - py) - (long long)(qy - py) * (x - px);
+}
+
+static inline long hires_floor(double x)
+{
+    long i = (long)x;
+    return (x < (double)i) ? i - 1 : i;
+}
+
+static inline int hires_top_left(long px, long py, long qx, long qy)
+{
+    return (qy < py) || (qy == py && qx > px);
+}
+
+void draw_gpoly_hires(struct PolyPoint *point_a, struct PolyPoint *point_b, struct PolyPoint *point_c,
+  int shaded, const ubyte *map, int pitch_sh, int scale)
+{
+    struct PolyPoint *pa = point_a, *pb = point_b, *pc = point_c;
+    long long area;
+    long min_x, max_x, min_y, max_y, x, y;
+    long long bias_a, bias_b, bias_c;
+    double inv_area, ua, ub, uc, va, vb, vc, sa, sb, sc;
+    const long mask = (1L << pitch_sh) - 1;
+
+    area = hires_edge(pa->X, pa->Y, pb->X, pb->Y, pc->X, pc->Y);
+    if (area == 0)
+        return;
+    if (area < 0) {
+        struct PolyPoint *tmp = pb; pb = pc; pc = tmp;
+        area = -area;
+    }
+    min_x = pa->X; max_x = pa->X; min_y = pa->Y; max_y = pa->Y;
+    if (pb->X < min_x) min_x = pb->X; if (pb->X > max_x) max_x = pb->X;
+    if (pc->X < min_x) min_x = pc->X; if (pc->X > max_x) max_x = pc->X;
+    if (pb->Y < min_y) min_y = pb->Y; if (pb->Y > max_y) max_y = pb->Y;
+    if (pc->Y < min_y) min_y = pc->Y; if (pc->Y > max_y) max_y = pc->Y;
+    if (min_x < 0) min_x = 0;
+    if (min_y < 0) min_y = 0;
+    if (max_x > vec_window_width - 1) max_x = vec_window_width - 1;
+    if (max_y > vec_window_height - 1) max_y = vec_window_height - 1;
+    if (min_x > max_x || min_y > max_y)
+        return;
+
+    /* w_a e' l'area opposta al vertice a (edge b->c), ecc.; sui bordi non top-left si esclude il punto */
+    bias_a = hires_top_left(pb->X, pb->Y, pc->X, pc->Y) ? 0 : -1;
+    bias_b = hires_top_left(pc->X, pc->Y, pa->X, pa->Y) ? 0 : -1;
+    bias_c = hires_top_left(pa->X, pa->Y, pb->X, pb->Y) ? 0 : -1;
+
+    inv_area = 1.0 / (double)area;
+    ua = (double)pa->U * (scale / 65536.0); ub = (double)pb->U * (scale / 65536.0); uc = (double)pc->U * (scale / 65536.0);
+    va = (double)pa->V * (scale / 65536.0); vb = (double)pb->V * (scale / 65536.0); vc = (double)pc->V * (scale / 65536.0);
+    sa = (double)(pa->S >> 16); sb = (double)(pb->S >> 16); sc = (double)(pc->S >> 16);
+
+    for (y = min_y; y <= max_y; y++)
+    {
+        ubyte *out = vec_screen + y * vec_screen_width;
+        for (x = min_x; x <= max_x; x++)
+        {
+            long long wa = hires_edge(pb->X, pb->Y, pc->X, pc->Y, x, y);
+            long long wb = hires_edge(pc->X, pc->Y, pa->X, pa->Y, x, y);
+            long long wc = hires_edge(pa->X, pa->Y, pb->X, pb->Y, x, y);
+            double fa, fb, fc, u, v;
+            long iu, iv;
+            ubyte texel;
+            if (wa + bias_a < 0 || wb + bias_b < 0 || wc + bias_c < 0)
+                continue;
+            fa = (double)wa * inv_area; fb = (double)wb * inv_area; fc = (double)wc * inv_area;
+            u = fa * ua + fb * ub + fc * uc;
+            v = fa * va + fb * vb + fc * vc;
+            iu = hires_floor(u) & mask;
+            iv = hires_floor(v) & mask;
+            texel = map[(iv << pitch_sh) | iu];
+            if (shaded) {
+                long shade = (long)(fa * sa + fb * sb + fc * sc) & 0xFF;
+                out[x] = pixmap.fade_table[(shade << 8) | texel];
+            } else {
+                out[x] = texel;
+            }
+        }
+    }
+}
