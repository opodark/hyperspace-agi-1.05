+    hires_base = base;
+    hires_end = end;
+    hires_sprites = hires;
+}
+
+const TbSprite *LbSpriteHiresOf(const TbSprite *sprite)
+{
+    const TbSprite *hi;
+
+    if (hires_base == NULL || sprite < hires_base || sprite >= hires_end)
+        return sprite;
+    hi = &hires_sprites[sprite - hires_base];
+    if (hi->Data == NULL || hi->SWidth != 2 * sprite->SWidth || hi->SHeight != 2 * sprite->SHeight)
+        return sprite;
+    return hi;
+}
