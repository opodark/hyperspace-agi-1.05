# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtualenv
venv/
.venv/
env/

# Environment
.env
.env.*
redteam_bot.env
!.env.example

# Node identity — mai committare chiavi private
data/
**/data/
# Le persone (persona-anna.json, persona-aurora.json) NON stanno in git: sono
# identità vive, distribuite SOLO via mesh cifrata (scripts/mesh_distribute.py
# --personas --all) così nessuna operazione git (merge, force-push, checkout)
# può cancellarle. Stanno in data/ (già gitignorata) e non vanno ri-tracciate.
*.pem
node_identity.json
peers.json

# WireGuard — le chiavi reali non finiscono mai nel repo
# (docs/wireguard-mesh-setup.md contiene solo un wg0.conf
# d'esempio con placeholder)
*.key
wg0.conf
*.wg-quick.conf

# Editor
.vscode/
.idea/
*.swp
*.swo
.worktrees/
.acl-backup-*.txt

# macOS
.DS_Store

# Docker
*.log

# Node
node_modules/

# Report generati — artefatti, non sorgenti (scripts/generate_test_report.py)
reports/
output/

# Knowledge graph del repository — artefatto dello strumento di sviluppo
# graphify (vedi docs/graphify.md): si rigenera, non si committa.
graphify-out*/
.graphify-venv/

# La ragnatela (Web Crawlers) — codice di terzi SENZA licenza: mai versionata
# (docs/spider.md). Sta sotto data/control-plane/ perche' e' l'unica cartella di
# dati che il container del control-plane vede, via il volume /app/data: il
# .gitignore generale (**/data/) la copre gia', e questa riga lo dice a chi legge.
data/control-plane/vendor/web-crawlers/
# Stato che i test e le baseline scrivono dove capita. Sono artefatti: se finiscono
# in un commit, il repo cresce a ogni esecuzione e `git status` diventa illeggibile.
control-plane/memory.json.gz
control-plane/memory-outbox.jsonl
control-plane/data/
control-plane/.venv/

# scripts/strixpersona.mjs: un report per giro, cresce a ogni esecuzione.
strixpersona_runs/
# output dello Strix originale (binario ~/.strix), non del nostro fork.
strix_runs/
